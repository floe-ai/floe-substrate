{
  "name": "floe-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "floe-bus",
    "floe-bridge",
    "floe-cli",
    "tests"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test --workspaces --if-present",
    "dev:bus": "npm run dev --workspace floe-bus",
    "dev:bridge": "npm run dev --workspace floe-bridge",
    "floe": "tsx floe-cli/src/index.ts",
    "install:cli": "node scripts/install-cli.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "node-domexception": "npm:domexception@4.0.0"
  }
}
