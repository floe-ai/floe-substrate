{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The end-to-end tests drive the other packages from their source, so this
    // project spans the repository. It is checked, never emitted: vitest runs it.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "../test-support/**/*.ts"]
}
