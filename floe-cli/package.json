{
  "name": "floe-cli",
  "version": "0.4.4",
  "private": true,
  "description": "The Floe command line — the front door to the local Floe substrate.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "floe": "./dist/index.js"
  },
  "exports": {
    "./local-channel": {
      "types": "./dist/local-channel/index.d.ts",
      "default": "./dist/local-channel/index.js"
    },
    "./installation": {
      "types": "./dist/installation.d.ts",
      "default": "./dist/installation.js"
    },
    "./engines/protocol": {
      "types": "./dist/engines/protocol.d.ts",
      "default": "./dist/engines/protocol.js"
    },
    "./engines": {
      "types": "./dist/engines/client.d.ts",
      "default": "./dist/engines/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build-native-authority.mjs && tsc -p tsconfig.json",
    "build:native": "node scripts/build-native-authority.mjs",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "nostr-tools": "^2.25.2",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^4.1.5"
  }
}
