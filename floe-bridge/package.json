{
  "name": "floe-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "floe-bridge": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts daemon",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "check:build": "npm run build && node scripts/check-build.mjs",
    "check:pack": "npm run build && node scripts/check-pack.mjs",
    "prepack": "npm run build",
    "start": "node dist/index.js daemon",
    "test": "vitest run"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "floe-runtime": "github:floe-ai/floe-runtime#4e21695972d29941f465f9edaf0f73a0a3c7acf0",
    "sharp": "0.35.4",
    "vite": "8.0.10",
    "yaml": "^2.6.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "tsx": "^4.19.0",
    "vitest": "^4.1.5"
  }
}
