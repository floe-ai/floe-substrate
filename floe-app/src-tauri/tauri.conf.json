{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Floe",
  "version": "0.1.80",
  "identifier": "com.floe.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5379",
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "beforeBuildCommand": "npm run build:sidecars && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Floe",
        "width": 1600,
        "height": 1000,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src http://127.0.0.1:5377/v1/previews/html; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/floe-node",
      "binaries/floe-authority-broker"
    ],
    "resources": [
      "resources/floe-desktop.js",
      "resources/isolated-command-host-process.js",
      "resources/isolated-extension-host-process.js",
      "resources/prompts/*.md",
      "resources/node_modules/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
