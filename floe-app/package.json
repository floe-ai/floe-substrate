{
  "name": "floe-app",
  "version": "0.1.80",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5379",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5379",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:html-preview": "node --import tsx scripts/check-html-preview.mjs",
    "test:model-preview": "node --import tsx scripts/check-model-preview.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:attach": "npm run build:sidecars && tauri dev --config src-tauri/tauri.attach.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@tauri-apps/api": "^2.11.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.10.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "0.185.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.10",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.185.0",
    "bun": "^1.3.11",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "playwright-core": "1.62.1",
    "vitest": "^4.1.6"
  }
}
